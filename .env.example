# =============================================================================
# Volunteer Scheduler (義工排班系統) — Environment Variables Example
# 複製此檔案並重新命名為 .env，填入對應的設定值。
# =============================================================================

# LINE LIFF App ID (用於前端 LINE 快速登入)
VITE_LIFF_ID=your_liff_id_here

# Google Apps Script Web App URL (後端 Webhook / 備份 API)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# LINE Messaging API Configuration (Vercel Serverless 後端使用)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# 管理員信箱 (用於接收即時補位通知信)
ADMIN_EMAIL=admin@example.com

# 系統前端網址
SYSTEM_URL=https://bolproduction.vercel.app

# Firebase Web App Configuration (Firestore 資料庫與快取)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
