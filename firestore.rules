rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function superAdmin() { return signedIn() && request.auth.token.role == 'super_admin'; }
    function teamLead(team) {
      return signedIn() && request.auth.token.role == 'team_lead' &&
        team in request.auth.token.managedTeams;
    }
    function self(volunteerId) { return signedIn() && request.auth.uid == volunteerId; }

    match /volunteers/{volunteerId} {
      allow read: if signedIn();
      allow create, delete: if superAdmin();
      allow update: if superAdmin() ||
        (teamLead('video') && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['videoSkills', 'isFullTimer', 'isBackfillLeader', 'updatedAt'])) ||
        (teamLead('audio') && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['audioSkills', 'updatedAt'])) ||
        (teamLead('light') && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lightLevel', 'updatedAt'])) ||
        (teamLead('stage') && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stageLevel', 'updatedAt'])) ||
        (self(volunteerId) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lineDisplayName', 'pictureUrl', 'updatedAt']));
    }

    match /formResponses/{responseId} {
      allow create: if signedIn() &&
        request.resource.data.volunteerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.team is string &&
        request.resource.data.cycleId is string;
      allow read: if superAdmin() ||
        (signedIn() && request.auth.token.role == 'team_lead') ||
        (signedIn() && resource.data.volunteerId == request.auth.uid);
      allow update, delete: if superAdmin() ||
        (signedIn() && request.auth.token.role == 'team_lead');
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow create, update: if superAdmin() ||
        (signedIn() && request.auth.token.role == 'team_lead' &&
          (scheduleId.matches('.*_final$') ||
           (request.resource.data.team is string &&
            request.resource.data.team in request.auth.token.managedTeams)));
      allow delete: if superAdmin();
    }

    match /line_groups/{groupId} { allow read, write: if false; }
    match /binding_requests/{requestId} { allow read, write: if false; }
    match /binding_invites/{inviteId} { allow read, write: if false; }
  }
}
